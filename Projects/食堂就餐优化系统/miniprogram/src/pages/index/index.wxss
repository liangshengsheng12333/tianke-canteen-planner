.page {
  padding: 24rpx;
}

.banner {
  padding: 20rpx 24rpx;
  border-radius: 12rpx;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.banner-sim {
  background: #fff4e5;
  color: #8a4b00;
  border: 1rpx solid #ffd591;
}

.tag {
  display: inline-block;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
  border-radius: 8rpx;
  background: #ff9800;
  color: #ffffff;
  font-size: 22rpx;
  font-weight: bold;
}

.card {
  background: #ffffff;
  border-radius: 12rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}

.title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  color: #1f2329;
}

.sub-title {
  font-size: 28rpx;
  font-weight: bold;
  margin: 20rpx 0 10rpx 0;
  color: #333333;
}

.picker-box {
  background: #f0f4ff;
  border: 1rpx solid #adc6ff;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-bottom: 12rpx;
}

.picker-value {
  color: #1d39c4;
  font-weight: 500;
}

.row {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  padding: 10rpx 0;
  border-bottom: 1rpx solid #f0f1f3;
  font-size: 28rpx;
}

.label {
  color: #646a73;
  flex-shrink: 0;
  max-width: 45%;
}

.value {
  text-align: right;
  word-break: break-all;
  color: #1f2329;
}

.code {
  font-family: monospace;
  font-size: 22rpx;
  background: #f5f5f5;
  padding: 2rpx 6rpx;
  border-radius: 4rpx;
}

.status {
  margin: 12rpx 0;
  font-size: 28rpx;
}

.status-ready {
  color: #1b7f3b;
  font-weight: bold;
}

.status-error {
  color: #c62828;
  font-weight: bold;
}

.error {
  color: #c62828;
  background: #fdecea;
  padding: 16rpx;
  border-radius: 8rpx;
  margin-bottom: 12rpx;
  word-break: break-all;
}

.ok {
  color: #1b7f3b;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.err {
  color: #c62828;
  margin-top: 12rpx;
  font-size: 28rpx;
}

.note {
  color: #646a73;
  margin: 12rpx 0;
  line-height: 1.5;
  font-size: 24rpx;
}

.note-warn {
  color: #d46b08;
  background: #fff7e6;
  padding: 12rpx 16rpx;
  border-radius: 6rpx;
}

.restore-badge {
  background: #f6ffed;
  color: #389e0d;
  border: 1rpx solid #b7eb8f;
  padding: 10rpx 16rpx;
  border-radius: 8rpx;
  margin: 12rpx 0;
  font-size: 24rpx;
}

.btn-group {
  margin: 16rpx 0;
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.result-box {
  margin-top: 20rpx;
  padding-top: 16rpx;
  border-top: 2rpx dashed #d9d9d9;
}

.badge {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
  margin-bottom: 12rpx;
}

.badge-info {
  background: #e6f7ff;
  color: #096dd9;
  border: 1rpx solid #91d5ff;
}

.badge-err {
  background: #fff1f0;
  color: #cf1322;
  border: 1rpx solid #ffa39e;
}

.meal-card {
  background: #fafafa;
  border: 1rpx solid #f0f0f0;
  border-radius: 8rpx;
  padding: 16rpx;
  margin-top: 12rpx;
}

.meal-header {
  display: flex;
  justify-content: space-between;
  margin-bottom: 8rpx;
}

.meal-name {
  font-weight: bold;
  color: #1f2329;
}

.meal-count {
  color: #8c8c8c;
  font-size: 24rpx;
}

.meal-items {
  font-size: 24rpx;
  color: #262626;
  margin-bottom: 8rpx;
}

.meal-ref {
  font-size: 22rpx;
  color: #1890ff;
}
