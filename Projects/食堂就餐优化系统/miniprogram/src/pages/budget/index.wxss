/* pages/budget/index.wxss — 预算与偏好的少量差异样式；颜色/卡片/表单沿用 app.wxss。 */

.banner {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  font-size: 28rpx;
  line-height: 1.5;
}
.banner-err {
  background: var(--tk-danger-bg);
  border: 1rpx solid var(--tk-danger-line);
  color: var(--tk-danger);
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 1rpx solid var(--tk-line);
}
.switch-row:last-child {
  border-bottom: none;
}
.switch-label {
  font-size: 32rpx;
  color: var(--tk-text);
}

.error-row {
  padding: 12rpx 0;
  border-bottom: 1rpx dashed var(--tk-line);
}
.error-row:last-child {
  border-bottom: none;
}