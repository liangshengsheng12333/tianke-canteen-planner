# ==============================================================================
# GitHub Linguist Overrides - Force C++ Primary Language
# ==============================================================================

# Exclude all HTML files (architecture diagrams, presentations, mockups) from language stats
*.html linguist-vendored
*.html linguist-documentation
*.htm linguist-vendored
*.htm linguist-documentation
*.svg linguist-vendored
*.svg linguist-documentation
*.json linguist-vendored
*.xml linguist-vendored
*.wxml linguist-vendored
*.wxss linguist-vendored
*.docx linguist-vendored
*.pptx linguist-vendored
*.zip linguist-vendored

# Exclude generated deliverables, evaluations and resources from language statistics
Projects/**/Resources/** linguist-vendored
Projects/**/Resources/** linguist-documentation
Projects/**/canteen-eval_20261026/** linguist-vendored
Projects/**/canteen-eval_20261026/** linguist-documentation
Projects/**/天科食客-期末评测全套交付包/** linguist-vendored
Projects/**/天科食客-期末评测全套交付包/** linguist-documentation
Projects/**/tools/** linguist-vendored
Resources/** linguist-vendored

# Prioritize C++ core
*.cpp linguist-language=C++
*.h linguist-language=C++
Projects/**/core/** linguist-detectable
Projects/**/core/src/*.cpp linguist-language=C++
Projects/**/core/cli/*.cpp linguist-language=C++
Projects/**/core/tests/*.cpp linguist-language=C++
Projects/**/core/include/mp/*.h linguist-language=C++
